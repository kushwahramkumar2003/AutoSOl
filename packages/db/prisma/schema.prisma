generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentSchedule {
  id                String                @id
  owner             String
  recipient         String
  mint              String
  totalAmount       BigInt                @map("total_amount")
  paymentAmount     BigInt                @map("payment_amount")
  feeAmount         BigInt                @default(0) @map("fee_amount")
  paymentCount      Int                   @map("payment_count")
  paymentsExecuted  Int                   @default(0) @map("payments_executed")
  isSol             Boolean               @default(true) @map("is_sol")
  status            PaymentScheduleStatus @default(ACTIVE)
  schedulePolicy    PaymentSchedulePolicy @default(STANDARD) @map("schedule_policy")
  proposalId        String?               @unique @map("proposal_id")
  requestId         String?               @unique @map("request_id")
  createdAt         DateTime              @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  payments          Payment[]
  proposal          PaymentCommitmentProposal? @relation("ScheduleProposal", fields: [proposalId], references: [id])
  request           PaymentRequestProposal? @relation("ScheduleRequest", fields: [requestId], references: [id])

  @@map("payment_schedules")
}

model PaymentCommitmentProposal {
  id                String                  @id
  owner             String
  recipient         String
  mint              String
  paymentAmount     BigInt                  @map("payment_amount")
  paymentCount      Int                     @map("payment_count")
  scheduleTimes     Json                    @map("schedule_times")
  memo              String
  noteUri           String                  @map("note_uri")
  isSol             Boolean                 @default(true) @map("is_sol")
  status            PaymentCommitmentStatus @default(PROPOSED)
  acceptedAt        DateTime?               @map("accepted_at")
  activatedAt       DateTime?               @map("activated_at")
  createdAt         DateTime                @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  activatedSchedule PaymentSchedule?        @relation("ScheduleProposal")

  @@map("payment_commitment_proposals")
  @@index([owner])
  @@index([recipient])
  @@index([status])
}

model PaymentRequestProposal {
  id                String               @id
  requester         String
  payer             String
  mint              String
  paymentAmount     BigInt               @map("payment_amount")
  paymentCount      Int                  @map("payment_count")
  scheduleTimes     Json                 @map("schedule_times")
  memo              String
  noteUri           String               @map("note_uri")
  isSol             Boolean              @default(true) @map("is_sol")
  status            PaymentRequestStatus @default(PROPOSED)
  decisionedAt      DateTime?            @map("decisioned_at")
  acceptedAt        DateTime?            @map("accepted_at")
  createdAt         DateTime             @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  activatedSchedule PaymentSchedule?     @relation("ScheduleRequest")

  @@map("payment_request_proposals")
  @@index([requester])
  @@index([payer])
  @@index([status])
}

model Payment {
  id           String          @id @default(cuid())
  scheduleId   String          @map("schedule_id")
  paymentIndex Int             @map("payment_index")
  amount       BigInt
  recipient    String
  mint         String
  isSol        Boolean         @default(true) @map("is_sol")
  executedAt   DateTime        @map("executed_at")
  executedBy   String          @map("executed_by")
  signature    String          @unique
  slot         BigInt
  createdAt    DateTime        @default(now()) @map("created_at")
  schedule     PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@map("payments")
  @@unique([scheduleId, paymentIndex])
}

model FeeWithdrawal {
  id          String   @id @default(cuid())
  amount      BigInt
  mint        String
  isSol       Boolean  @default(true) @map("is_sol")
  withdrawnBy String   @map("withdrawn_by")
  withdrawnAt DateTime @map("withdrawn_at")
  signature   String   @unique
  slot        BigInt
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("fee_withdrawals")
}

model FeePercentageUpdate {
  id            String   @id @default(cuid())
  oldPercentage Int      @map("old_percentage")
  newPercentage Int      @map("new_percentage")
  updatedAt     DateTime @map("updated_at")
  signature     String   @unique
  slot          BigInt
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("fee_percentage_updates")
}

model EventLog {
  id            String      @id @default(cuid())
  eventKey      String      @unique @map("event_key")
  eventType     String      @map("event_type")
  signature     String
  slot          BigInt
  status        EventStatus @default(PENDING)
  streamId      String?     @map("stream_id")
  error         String?
  retryCount    Int         @default(0) @map("retry_count")
  eventData     Json        @map("event_data")
  lastAttemptAt DateTime    @default(now()) @map("last_attempt_at")
  processedAt   DateTime?   @map("processed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("event_logs")
  @@index([signature])
}

enum PaymentScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentSchedulePolicy {
  STANDARD
  COMMITMENT
  REQUEST
}

enum PaymentCommitmentStatus {
  PROPOSED
  ACCEPTED
  ACTIVATED
}

enum PaymentRequestStatus {
  PROPOSED
  DECLINED
  REVOKED
  ACCEPTED
}

enum EventStatus {
  PENDING
  PROCESSING
  RETRYING
  PROCESSED
  DEAD_LETTER
  FAILED
}
