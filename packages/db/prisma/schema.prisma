generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentSchedule {
  id                String                @id
  owner             String
  recipient         String
  mint              String
  totalAmount       BigInt                @map("total_amount")
  paymentAmount     BigInt                @map("payment_amount")
  feeAmount         BigInt                @default(0) @map("fee_amount")
  paymentCount      Int                   @map("payment_count")
  paymentsExecuted  Int                   @default(0) @map("payments_executed")
  isSol             Boolean               @default(true) @map("is_sol")
  status            PaymentScheduleStatus @default(ACTIVE)
  createdAt         DateTime              @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  payments          Payment[]

  @@map("payment_schedules")
}

model Payment {
  id           String          @id @default(cuid())
  scheduleId   String          @map("schedule_id")
  paymentIndex Int             @map("payment_index")
  amount       BigInt
  recipient    String
  mint         String
  isSol        Boolean         @default(true) @map("is_sol")
  executedAt   DateTime        @map("executed_at")
  executedBy   String          @map("executed_by")
  signature    String          @unique
  slot         BigInt
  createdAt    DateTime        @default(now()) @map("created_at")
  schedule     PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@map("payments")
  @@unique([scheduleId, paymentIndex])
}

model FeeWithdrawal {
  id          String   @id @default(cuid())
  amount      BigInt
  mint        String
  isSol       Boolean  @default(true) @map("is_sol")
  withdrawnBy String   @map("withdrawn_by")
  withdrawnAt DateTime @map("withdrawn_at")
  signature   String   @unique
  slot        BigInt
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("fee_withdrawals")
}

model FeePercentageUpdate {
  id            String   @id @default(cuid())
  oldPercentage Int      @map("old_percentage")
  newPercentage Int      @map("new_percentage")
  updatedAt     DateTime @map("updated_at")
  signature     String   @unique
  slot          BigInt
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("fee_percentage_updates")
}

model EventLog {
  id            String      @id @default(cuid())
  eventKey      String      @unique @map("event_key")
  eventType     String      @map("event_type")
  signature     String
  slot          BigInt
  status        EventStatus @default(PENDING)
  streamId      String?     @map("stream_id")
  error         String?
  retryCount    Int         @default(0) @map("retry_count")
  eventData     Json        @map("event_data")
  lastAttemptAt DateTime    @default(now()) @map("last_attempt_at")
  processedAt   DateTime?   @map("processed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("event_logs")
  @@index([signature])
}

enum PaymentScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventStatus {
  PENDING
  PROCESSING
  RETRYING
  PROCESSED
  DEAD_LETTER
  FAILED
}
