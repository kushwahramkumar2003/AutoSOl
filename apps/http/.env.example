# Local HTTP backend configuration
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autosol"
SOLANA_RPC_URL="http://127.0.0.1:8899"
# Token mint resolution: "mainnet" | "devnet" — Surfpool uses mainnet mints
SOLANA_TOKEN_ENV="mainnet"
REDIS_URL="redis://127.0.0.1:6379"
REDIS_QUEUE="solana_auto_sol_events"
REDIS_STREAM="solana_auto_sol_events_stream"
