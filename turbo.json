{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "AUTH_TOKEN_EXPIRATION_TIME",
        "NEXT_PUBLIC_RPC_URL",
        "NEXT_PUBLIC_RPC_URL_DEVNET",
        "NEXT_PUBLIC_RPC_URL_MAINNET",
        "NEXT_PUBLIC_RPC_URL_TESTNET",
        "NEXT_PUBLIC_RPC_URL_LOCALNET",
        "RPC_URL",
        "PINATA_JWT",
        "PINATA_UPLOAD_URL",
        "PINATA_GATEWAY_URL",
        "PINATA_API_KEY",
        "PINATA_API_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
