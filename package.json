{
  "name": "AutoSOl",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "rebuild": "npm rebuild",
    "surfpool:fresh": "NO_DNA=1 surfpool start --db :memory: --surfnet-id fresh-local --no-deploy --no-tui --no-studio",
    "wallet:generate": "node scripts/generate-solana-wallet.cjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "overrides": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7"
  },
  "resolutions": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
